# ============================================================
# BH-ERP 后端环境变量模板
# 使用方式：复制为 backend/.env 后按本机情况修改
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env 已被 .gitignore 忽略，请勿把真实密码提交到仓库。
# ============================================================

# ---------- 应用 ----------
APP_NAME=BH-ERP
APP_VERSION=0.1.0
DEBUG=true

# 允许跨域访问的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- MySQL ----------
# 本地开发示例：数据库名建议 bh_erp
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bh_erp
DB_USER=root
DB_PASSWORD=

# 打印 SQL 便于调试，生产环境请保持 false
DB_ECHO=false
