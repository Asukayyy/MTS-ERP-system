# ============================================================
# BH-ERP 前端环境变量模板
# 使用方式：复制为 frontend/.env 后按需修改
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# 只有 VITE_ 前缀的变量会暴露给前端代码。
# 不要在这里放任何密码、密钥。
# ============================================================

# 页面标题
VITE_APP_TITLE=BH-ERP

# 后端接口基础地址。
# 开发环境保持 /api/v1，由 vite.config.ts 的 proxy 转发到 http://127.0.0.1:8000
VITE_API_BASE_URL=/api/v1
